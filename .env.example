# =============================================
# قاعدة البيانات
# =============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_recruitment"

# =============================================
# NextAuth - المصادقة
# =============================================
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# =============================================
# OpenAI API
# =============================================
OPENAI_API_KEY="sk-proj-..."

# النماذج المستخدمة (اختياري - للتخصيص)
OPENAI_MODEL_CHAT="gpt-4o"
OPENAI_MODEL_EMBEDDING="text-embedding-3-large"
OPENAI_EMBEDDING_DIMENSIONS="1536"

# =============================================
# Semantic Scholar API
# =============================================
SEMANTIC_SCHOLAR_API_KEY=""

# =============================================
# ORCID API
# =============================================
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""

# =============================================
# Cron Jobs
# =============================================
CRON_SECRET="your-cron-secret-key-for-vercel"

# =============================================
# رفع الملفات
# =============================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# =============================================
# البريد الإلكتروني (للإشعارات)
# =============================================
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="نظام الاستقطاب <notifications@example.com>"

# =============================================
# الإعدادات العامة
# =============================================
DEFAULT_LOCALE="ar"
NODE_ENV="development"
